{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talentscreen.local/contracts/assessment-output/1.0.0",
  "title": "TalentScreen AI Assessment Model Output v1",
  "description": "Model-generated payload only. Backend attaches metadata, resolves sources, validates approved rubric and computes aggregates/recommendation. Strict Pydantic validation is additionally required.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "criteria"
  ],
  "properties": {
    "criteria": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/criterion"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "criterion_id"
            ],
            "properties": {
              "criterion_id": {
                "const": "python_backend"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "criterion_id"
            ],
            "properties": {
              "criterion_id": {
                "const": "api_design"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "criterion_id"
            ],
            "properties": {
              "criterion_id": {
                "const": "sql_data"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "criterion_id"
            ],
            "properties": {
              "criterion_id": {
                "const": "testing_debugging"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "criterion_id"
            ],
            "properties": {
              "criterion_id": {
                "const": "security_privacy"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "criterion_id"
            ],
            "properties": {
              "criterion_id": {
                "const": "delivery_ops"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "span_id",
        "quote"
      ],
      "properties": {
        "span_id": {
          "type": "string",
          "pattern": "^spn_[0-9a-f]{24}$"
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200,
          "description": "Must equal the complete immutable sanitized source span text. Exact source ownership, input inclusion and equality are checked by backend, not JSON Schema."
        }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "status",
        "score",
        "evidence",
        "rationale",
        "missing_information"
      ],
      "properties": {
        "criterion_id": {
          "type": "string",
          "enum": [
            "python_backend",
            "api_design",
            "sql_data",
            "testing_debugging",
            "security_privacy",
            "delivery_ops"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "assessed",
            "insufficient_evidence",
            "conflicting_evidence"
          ]
        },
        "score": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4
        },
        "evidence": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "missing_information": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "assessed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "evidence": {
                "minItems": 1
              },
              "missing_information": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "insufficient_evidence"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "score": {
                "type": "null"
              },
              "missing_information": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "conflicting_evidence"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "score": {
                "type": "null"
              },
              "evidence": {
                "minItems": 2
              },
              "missing_information": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
