# ==============================================================================
# TalentScreen AI — Environment Configuration Template
# All secrets and local configurations must stay out of Git.
# ==============================================================================

# Environment mode: 'sandbox' (default for dev/synthetic) or 'pilot'
APP_ENV=sandbox

# Pilot stage: empty/null in sandbox; 'shadow' or 'assisted' only when APP_ENV=pilot
PILOT_STAGE=

# Server binding & origins
APP_BIND_HOST=127.0.0.1
APP_PORT=8000
APP_ORIGIN=http://localhost:2004

# Database URLs (PostgreSQL 16 + pgvector)
# Async URL used by FastAPI / asyncpg
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/talentscreen
# Sync URL used by Alembic migrations
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/talentscreen

# Private Storage (absolute or relative to workspace, kept out of git & public directories)
PRIVATE_STORAGE_ROOT=./private_storage

# Application Security
# Generate with: openssl rand -hex 32
SECRET_KEY=dev_secret_key_change_in_production_min_32_characters_needed

# LLM Provider configuration
# 'mock' (default, free, no external network calls) or 'deepseek'
LLM_PROVIDER=mock
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=

# Optional structured scoring with TypeSafe Jev 1.13 via OpenRouter System One.
# Keep disabled until the school separately approves this processor and verifies its current rate card.
JEV_MODE=off
JEV_BASE_URL=https://openrouter.ai/api/v1/systemone
JEV_MODEL=typesafe/jev-1.13
JEV_API_KEY=
JEV_DATA_PROCESSING_APPROVED=false
JEV_INPUT_PRICE_PER_MILLION_USD=
JEV_RATE_CARD_VERIFIED_AT=

# Optional developer-only LangSmith tracing. Exported spans contain metadata only.
# CVs, JD text, prompts, model responses, queries and exception bodies are never exported.
# Enable only after setting your own key; no HR-facing trace panel.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=talentscreen-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Policy and Sanitization enforcement
EXTERNAL_REAL_DATA_POLICY=allowed_deepseek_confirmed_by_owner
REQUIRE_SANITIZED_APPROVAL=true

# Embedding configuration
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DEVICE=auto
EMBEDDING_MODEL_REVISION=d128750597153bb5987e10b1c3493a34e5a4502a
RAG_MODE=full_text_baseline
# v2: canonical claim chunks + exact dedup + concise bilingual queries; v1 replays legacy ranking.
RAG_PIPELINE_VERSION=v1

# Worker and Concurrency limits
WORKER_CONCURRENCY=1
LLM_MAX_CONCURRENCY=1
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_SECONDS=20

# Intake upload limits
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_PAGES=10
UPLOAD_BATCH_MAX_FILES=20

# Resilience and Timeouts
LLM_STAGE_MAX_ATTEMPTS=2
ASSESSMENT_MAX_EXTERNAL_CALLS=4
LLM_READ_TIMEOUT_SECONDS=90
ASSESSMENT_DEADLINE_SECONDS=900

# Budget caps (USD)
DEV_EVAL_BUDGET_USD=10.00
PILOT_MONTHLY_BUDGET_USD=10.00
# Per-requisition ceiling; blank inherits DEV_EVAL_BUDGET_USD in sandbox and is required outside sandbox.
REQUISITION_LLM_BUDGET_USD=
RATE_CARD_VERIFIED_AT=

# Data retention policy
RETENTION_POLICY_ID=default_sandbox_retention

# Optional pre-primary passage ranking; enable only after benchmark validation.
JEV_RERANK_MODE=off
JEV_RERANK_ACCEPTED_MODELS=[]
