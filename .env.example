# ==============================================================================
# TalentScreen AI — Environment Configuration Template
# All secrets and local configurations must stay out of Git.
# ==============================================================================

# Environment mode: 'sandbox' (default for dev/synthetic) or 'pilot'
APP_ENV=sandbox

# Pilot stage: empty/null in sandbox; 'shadow' or 'assisted' only when APP_ENV=pilot
PILOT_STAGE=

# Server binding & origins
APP_BIND_HOST=127.0.0.1
APP_PORT=8000
APP_ORIGIN=http://localhost:3000

# Database URLs (PostgreSQL 16 + pgvector)
# Async URL used by FastAPI / asyncpg
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/talentscreen
# Sync URL used by Alembic migrations
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/talentscreen

# Private Storage (absolute or relative to workspace, kept out of git & public directories)
PRIVATE_STORAGE_ROOT=./private_storage

# Application Security
# Generate with: openssl rand -hex 32
SECRET_KEY=dev_secret_key_change_in_production_min_32_characters_needed

# LLM Provider configuration
# 'mock' (default, free, no external network calls) or 'deepseek'
LLM_PROVIDER=mock
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=

# Policy and Sanitization enforcement
EXTERNAL_REAL_DATA_POLICY=allowed_deepseek_confirmed_by_owner
REQUIRE_SANITIZED_APPROVAL=true

# Embedding configuration
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DEVICE=auto
EMBEDDING_MODEL_REVISION=main
RAG_MODE=full_text_baseline

# Worker and Concurrency limits
WORKER_CONCURRENCY=1
LLM_MAX_CONCURRENCY=1
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_SECONDS=20

# Intake upload limits
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_PAGES=10
UPLOAD_BATCH_MAX_FILES=20

# Resilience and Timeouts
LLM_STAGE_MAX_ATTEMPTS=2
ASSESSMENT_MAX_EXTERNAL_CALLS=4
LLM_READ_TIMEOUT_SECONDS=90
ASSESSMENT_DEADLINE_SECONDS=900

# Budget caps (USD)
DEV_EVAL_BUDGET_USD=10.00
PILOT_MONTHLY_BUDGET_USD=10.00
RATE_CARD_VERIFIED_AT=

# Data retention policy
RETENTION_POLICY_ID=default_sandbox_retention
